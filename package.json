{
  "name": "gestione-casa",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "./dev.sh",
    "dev:debug": "./dev.sh --debug",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test apps/api packages/shared-types && bun run --filter '@gc/web' test",
    "e2e": "DATABASE_URL=postgres://gctest:gctest@localhost:5432/gc_test JWT_SECRET=e2e-secret bun test e2e/",
    "lint": "prettier --check ."
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
